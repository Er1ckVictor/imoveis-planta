# ============================================================
# Planta Imóveis — configuração
# Copie para .env, edite e reinicie `npm run dev` (ou rode `npm run build`).
# ============================================================

# ---------- SEO ----------
# Endereço do site publicado
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Título que aparece no Google e na aba do navegador
NEXT_PUBLIC_SEO_TITLE=Planta Imóveis | Compra, venda e locação de imóveis
# Descrição que aparece no Google e ao compartilhar o link
NEXT_PUBLIC_SEO_DESCRIPTION=Compra, venda e locação de imóveis residenciais e comerciais, com avaliação gratuita e acompanhamento até a escritura.

# ---------- Telefone ----------
# Só números, com 55 + DDD. Usado para ligações, WhatsApp e o formulário de orçamento.
NEXT_PUBLIC_PHONE=5511900000000
